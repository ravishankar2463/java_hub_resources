          },
          "bottom": {
            "label": "Virtual Threads",
            "badge": "Simple",
            "tone": "good",
            "code": "Blocking I/O",
            "points": [
              "Easy to read",
              "Massive scale"
            ]
          },
          "narration": "NIO is great for proxies, but Virtual Threads are the new standard for application logic. Keep your code simple and let the JVM handle the scheduling.",
          "durationSec": 11,
          "sfx": "whoosh"
