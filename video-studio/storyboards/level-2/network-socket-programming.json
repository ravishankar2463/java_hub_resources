    {
      "partNumber": 4,
      "partSlug": "part-4-scaling-virtual-threads",
      "partTitle": "Scaling with Virtual Threads",
      "beats": [
        {
          "id": "p4-b1-hook",
          "kind": "hook",
          "eyebrow": "Network Sockets • Part 4 of 4",
          "headline": "Stop using thread pools for sockets.",
          "highlightWord": "thread pools",
          "subline": "Virtual threads make blocking I/O scale to 100k+ connections.",
          "narration": "Platform threads are expensive. Virtual threads are cheap. You can now write simple blocking code that handles massive concurrency without complex NIO selectors.",
          "durationSec": 10,
          "sfx": "pop"
        },
        {
          "id": "p4-b2-code-vthread",
          "kind": "code-spotlight",
          "title": "Virtual Thread Server",
          "filename": "Server.java",
          "code": "try (var executor = Executors.newVirtualThreadPerTaskExecutor()) {\n    while (true) {\n        Socket client = ss.accept();\n        executor.submit(() -> handle(client));\n    }\n}",
          "steps": [
            {
              "lines": [
                1
              ],
              "badge": "VThreads",
              "explanation": "One thread per socket.",
              "accent": "emerald"
            },
            {
              "lines": [
                3
              ],
              "badge": "Accept",
              "explanation": "Blocks until connection.",
              "accent": "sky"
            },
            {
              "lines": [
                4
              ],
              "badge": "Submit",
              "explanation": "Cheap task creation.",
              "accent": "amber"
            }
          ],
          "narration": "Virtual threads unmount from the carrier thread when blocking. This allows you to write readable, blocking code that scales to hundreds of thousands of sockets.",
          "durationSec": 12,
          "sfx": "keyclick"
        },
        {
          "id": "p4-b3-compare",
          "kind": "compare",
          "title": "Scaling Strategy",
          "top": {
            "label": "NIO Selector",
            "badge": "Complex",
            "tone": "neutral",
            "code": "Event Loop",
            "points": [
