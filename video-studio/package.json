{
  "name": "javahub-video-studio",
  "version": "1.0.0",
  "private": true,
  "description": "100% local, open-source summary video generator for JavaHub roadmap chapters using Remotion + Kokoro-82M TTS",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "generate": "tsx scripts/generate.ts",
    "batch-all": "tsx scripts/batch-all.ts",
    "list": "tsx scripts/generate.ts --list",
    "youtube:auth": "tsx scripts/youtube-upload.ts auth",
    "youtube:status": "tsx scripts/youtube-upload.ts status",
    "youtube:stage": "tsx scripts/youtube-upload.ts stage",
    "youtube:sync-channel": "tsx scripts/youtube-upload.ts sync-channel",
    "youtube:reschedule": "tsx scripts/youtube-upload.ts reschedule",
    "youtube:upload": "tsx scripts/youtube-upload.ts upload",
    "youtube:publish-due": "tsx scripts/youtube-upload.ts publish-due",
    "youtube:set-id": "tsx scripts/youtube-upload.ts set-id",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.286",
    "@remotion/cli": "4.0.286",
    "@remotion/renderer": "4.0.286",
    "gray-matter": "^4.0.3",
    "kokoro-js": "^1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "4.0.286"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
